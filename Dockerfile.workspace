FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY JARVIS_AtomicNodes ./JARVIS_AtomicNodes
COPY JARVIS_NodeRegistry ./JARVIS_NodeRegistry

RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir "./JARVIS_AtomicNodes[metadata]" && \
    python -m pip install --no-cache-dir ./JARVIS_NodeRegistry

CMD ["arp-jarvis-node-registry", "--host", "0.0.0.0", "--port", "8084"]
